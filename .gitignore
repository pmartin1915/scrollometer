# Generated by XcodeGen — never commit
*.xcodeproj
*.xcworkspace

# Xcode / Swift build artifacts
DerivedData/
.build/
.swiftpm/
xcuserdata/
*.xcuserstate

# SPM — but keep package-level resolutions committed for reproducible CI test runs
Package.resolved
!Packages/**/Package.resolved

# macOS
.DS_Store

# Fastlane
fastlane/report.xml
fastlane/screenshots/**/*.png
fastlane/test_output

# Orchestration scratch
.orchestrate/

# Session-local Claude settings
.claude/
